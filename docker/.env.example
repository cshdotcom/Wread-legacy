# WRead Docker Compose Environment Configuration
# Copy this file to .env and customize values

# Port to expose WRead on
WREAD_PORT=2586

# JWT Authentication
# Change this to a strong random string (at least 32 characters)
WREAD_JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
WREAD_JWT_EXPIRY=7d

# Admin Account (default credentials, change in production)
WREAD_ADMIN_EMAIL=c135860@outlook.com
WREAD_ADMIN_PASSWORD=15068253855z

# Self-registration (set to true to allow new users to register)
WREAD_ALLOW_SELF_REGISTER=false

# Storage Quota (bytes) - default 10GB for self-hosted
# Set to 0 for admin to have unlimited storage
STORAGE_FIXED_QUOTA=10737418240

# Daily Translation Quota (characters) - default 500k
TRANSLATION_FIXED_QUOTA=500000

# LibreTranslate URL (built-in cloud translation service)
# Default: ta.910500.xyz (no API key required)
LIBRETRANSLATE_URL=https://ta.910500.xyz

# Email/SMTP Configuration (for Send to WRead feature)
# These are required for the email-to-library feature
WREAD_SMTP_HOST=
WREAD_SMTP_PORT=587
WREAD_SMTP_SECURE=false
WREAD_SMTP_USER=
WREAD_SMTP_PASS=
WREAD_SMTP_FROM_ADDRESS=noreply@wread.local

# IMAP Configuration (for receiving emails)
WREAD_IMAP_HOST=
WREAD_IMAP_PORT=993
WREAD_IMAP_SECURE=true
WREAD_IMAP_USER=
WREAD_IMAP_PASS=
