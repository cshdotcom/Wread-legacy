# WRead Environment Configuration
# For self-hosted deployment

NEXT_PUBLIC_APP_PLATFORM=web

# Local SQLite database path
WREAD_DB_PATH=./data/wread.db

# Local file storage path
WREAD_STORAGE_PATH=./data/storage

# JWT secret (change this in production!)
WREAD_JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
WREAD_JWT_EXPIRY=7d

# Admin account (created on first startup)
WREAD_ADMIN_EMAIL=admin@wread.local
WREAD_ADMIN_PASSWORD=admin

# Storage quota (bytes, default 10GB)
STORAGE_FIXED_QUOTA=10737418240

# Daily translation quota (characters, default 500k)
TRANSLATION_FIXED_QUOTA=500000

# LibreTranslate URL (optional)
LIBRETRANSLATE_URL=

# PDF.js paths (for development)
PDFJS_BUILD_PATH=../../packages/foliate-js/node_modules/pdfjs-dist/legacy/build
PDFJS_FONTS_PATH=../../packages/foliate-js/node_modules/pdfjs-dist
PDFJS_STYLE_PATH=../../packages/foliate-js/vendor/pdfjs
