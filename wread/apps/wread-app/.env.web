NEXT_PUBLIC_APP_PLATFORM=web
PORT=3000

# WRead Database
WREAD_DB_PATH=./data/wread.db

# WRead File Storage
WREAD_STORAGE_PATH=./data/storage

# JWT Authentication
WREAD_JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
WREAD_JWT_EXPIRY=7d

# Admin Account (created on first startup)
WREAD_ADMIN_EMAIL=c135860@outlook.com
WREAD_ADMIN_PASSWORD=15068253855z

# User Registration (set to true to allow self-registration)
WREAD_ALLOW_SELF_REGISTER=false

# Storage Quota (in bytes, default 10GB = 10737418240)
STORAGE_FIXED_QUOTA=10737418240

# Translation Quota (daily characters, default 500K)
TRANSLATION_FIXED_QUOTA=500000

# LibreTranslate Server (for self-hosted translation)
LIBRETRANSLATE_URL=https://ta.910500.xyz
# LIBRETRANSLATE_API_KEY=your-api-key-if-needed

# DeepL API Keys (optional, alternative to LibreTranslate)
# DEEPL_FREE_API_KEYS=key1,key2
# DEEPL_PRO_API_KEYS=key1,key2

# Server URL (for generating download/share URLs)
PROTOCOL=http
HOST=localhost:3000

# Public runtime config (exposed to client via /runtime-config.js)
NEXT_PUBLIC_STORAGE_FIXED_QUOTA=10737418240
NEXT_PUBLIC_TRANSLATION_FIXED_QUOTA=500000
NEXT_PUBLIC_LIBRETRANSLATE_URL=https://ta.910500.xyz
